# Aikount MCP server configuration
# Long-lived API key (scope *). Mint it from the web app's "Conectar agente"
# button. Treat it like a password — never commit it.
AIKOUNT_TOKEN=agl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API base. Defaults to production; override for staging / self-hosted.
# AIKOUNT_API=https://api.aikount.com/api/v1

# Transport: stdio (default, for local MCP clients) or streamable-http.
# AIKOUNT_MCP_TRANSPORT=stdio
